  itemModifiers: []
  modifierDescriptions:
  - modifier: golden
    description: '{yellow}<wave>golden</wave>: 3x gold, 0.5x durability{end}'
  - modifier: sapphire
    description: '{yellow}<wave>sapphire</wave>: 4x gold, 0.3x durability{end}'
  - modifier: sharpening
    description: '{yellow}<wave>sharpening</wave>: +4 damage{end}'
  - modifier: long handle
    description: '{yellow}<wave>long handle</wave>: 2x mining radius, 0.75x durability{end}'
  - modifier: huge weight
    description: '{yellow}<wave>huge weight</wave>: 1.5x delay, damage near ores{end}'
  - modifier: lightweight
    description: '{yellow}<wave>lightweight</wave>: 0.75x delay, 0.75x durability,
      1.5x speed{end}'
  - modifier: melting
    description: '{yellow}<wave>melting</wave>: melts ores into puddles that damage
      other ores, 0.5x durability{end}'
  - modifier: elastic
    description: '{yellow}<wave>elastic</wave>: 0.8x damage, 1.5x durability{end}'
  - modifier: good aim
    description: '{yellow}<wave>good aim</wave>: chance of critical hit{end}'
  - modifier: warranty card
    description: '{yellow}<wave>warranty card</wave>: 2x durability{end}'
  - modifier: fragile
    description: '{red}<wave>fragile</wave>: 0.5x durability{end}'
  - modifier: expensive
    description: '{red}<wave>expensive</wave>: every hit costs you gold{end}'
  - modifier: bad counter
    description: '{red}<wave>bad counter</wave>: durability decreases randomly{end}'
